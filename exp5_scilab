clc;
g = 7;
p = 23;

printf("\nThe results are as follows:\n\n");

x = 3;   // Alice's private key
y = 6;   // Bob's private key

R1 = modulo(g^x, p);   // Alice computes R1
R2 = modulo(g^y, p);   // Bob computes R2

printf("1) Alice chooses x=%d & calculates R1=%d\n\n", x, R1);
printf("2) Bob chooses y=%d & calculates R2=%d\n\n", y, R2);
printf("3) Alice sends the number %d to Bob\n\n", R1);
printf("4) Bob sends the number %d to Alice\n\n", R2);

K_Alice = modulo(R2^x, p);
K_Bob   = modulo(R1^y, p);
K_Final = modulo(g^(x*y), p);

printf("5) Alice calculates the symmetric key K=%d\n\n", K_Alice);
printf("6) Bob calculates the symmetric key K=%d\n\n", K_Bob);
printf("7) K_Final=%d\n\n", K_Final);
